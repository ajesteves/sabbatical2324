{
    "decoder": {
        "unets": [
            {
                "dim":             64,
                "image_embed_dim": 512,
                "cond_dim":        64,
                "channels":        3,
                "dim_mults":       [1, 1, 2, 4],
                "attn_dim_head":   16,
                "attn_heads":      8
            }
        ],
        "image_sizes":          [64],
        "channels":             3,
        "timesteps":            1000,
        "loss_type":            "l2",
        "beta_schedule":        ["cosine"],
        "learned_variance":     true
    },
    "data": {
        "webdataset_base_url":  "file://OUR_DATASETS_DIR/laion_aesthetics_65p_wds/{}.tar",
        "img_embeddings_url":   "file://OUR_DATASETS_DIR/laion_aesthetics_65p_embeds_v2/img_emb_ordered/",
        "num_workers":          4,
        "start_shard":          0,
        "end_shard":            61,
        "shard_width":          5,
        "index_width":          4,
        "splits": {
            "train":            0.75,
            "val":              0.15,
            "test":             0.1
        },
        "shuffle_train":        true,
        "resample_train":       false,
        "preprocessing": {
            "RandomResizedCrop": {
                "size":         [64, 64],
                "scale":        [0.75, 1.0],
                "ratio":        [1.0, 1.0]
            },
            "ToTensor":         true
        }
    },
    "train": {
        "epochs":               20,
        "batch_size":           16,
        "lr":                   0.0001,
        "wd":                   0.01,
        "max_grad_norm":        0.5,
        "save_every_n_samples": 100000,
        "n_sample_images":      6,
        "epoch_samples":        null,
        "validation_samples":   null,
        "use_ema":              true,
        "ema_beta":             0.99,
        "amp":                  false,
        "unet_training_mask":   [true]
    },
    "evaluate": {
        "n_evaluation_samples": 1000,
        "FID": {
            "feature":          64
        },
        "IS": {
            "feature":          64,
            "splits":           10
        },
        "KID": {
            "feature":          64,
            "subset_size":      10
        },
        "LPIPS": {
            "net_type":         "vgg",
            "reduction":        "mean"
        }
    },
    "tracker": {
        "overwrite_data_path":  true,

        "log": {
            "log_type":         "wandb",
            "wandb_entity":     "OUR_WANDB_ENTITY",
            "wandb_project":    "OUR_WANDB_PROJECT_ID",
            "verbose":          true
        },

        "load": {
            "load_from":        null
        },

        "save": 
            [
                {
                    "save_to":          "wandb",
                    "save_latest_to":   "decoder_latest.pth"
                },
                {
                    "save_to":          "local",
                    "save_latest_to":   "OUR_WORK_DIR/models/dalle2_01/decoder_latest.pth",
                    "save_best_to":     "OUR_WORK_DIR/models/dalle2_01/decoder_best.pth",
                    "save_meta_to":     "OUR_WORK_DIR/models/dalle2_01",
                    "save_type":        "model"
                }
            ]
    }
}
